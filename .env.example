# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
ECHO_ADMIN_TOKEN=
ECHO_SECRET_KEY=

# The URL people will open. Used as the API's CORS origin.
ECHO_PUBLIC_URL=http://localhost:8080
# ":80" for plain HTTP on ECHO_HTTP_PORT; or your domain (echo.example.com) for automatic HTTPS
# (then set ECHO_HTTP_PORT=80, ECHO_HTTPS_PORT=443 and ECHO_PUBLIC_URL=https://echo.example.com).
ECHO_SITE=:80
ECHO_HTTP_PORT=8080
ECHO_HTTPS_PORT=8443

# daily = 候场区: the city opens when 12 seats are taken, then advances one day per day (default)
# fast = continuous cycles for demos; weekly = legacy Mon 19:00 schedule
ECHO_MODE=daily
# Lobby seats, and how long after the first player sits down house bots may fill the rest (-1 = never)
ECHO_LOBBY_SEATS=12
ECHO_LOBBY_FILL_MS=21600000
# Run a 12-bot demo cycle on first boot so the city isn't empty
ECHO_AUTODEMO=1
